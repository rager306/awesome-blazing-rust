{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "awesome-blazing-rust signals v1",
  "description": "Third-party context about a catalog entry. DATA, NOT EVIDENCE: nothing here may raise a card's Type. Flags are objective facts or human verdicts; disputes are unverified pointers a maintainer resolves.",
  "type": "object",
  "required": [
    "meta",
    "repos"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "format",
        "generated_at",
        "repos"
      ],
      "properties": {
        "format": {
          "const": "awesome-blazing-rust signals v1"
        },
        "rule": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flag_vocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "repos": {
          "type": "integer"
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "observed_at",
          "flags"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$",
            "description": "owner/name on GitHub"
          },
          "observed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "github": {
            "type": "object",
            "properties": {
              "archived": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "pushed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stars": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "attention, never a score"
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "crate": {
            "type": [
              "object",
              "null"
            ],
            "description": "null when the repository name is not a crate, or when crates.io points at a different repository",
            "properties": {
              "name": {
                "type": "string"
              },
              "downloads": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "recent_downloads": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "versions": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "yanked": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "updated_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "attention": {
            "type": "object",
            "description": "mention volume. A loss function for anomaly detection, never a score and never shown on a card.",
            "properties": {
              "stories": {
                "type": "integer"
              },
              "comments": {
                "type": "integer"
              }
            }
          },
          "advisories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          },
          "disputes": {
            "type": "array",
            "description": "unverified critique pointers: a human promotes them to a verdict or ignores them",
            "items": {
              "type": "object",
              "required": [
                "source",
                "url",
                "status"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "marker": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "status": {
                  "const": "unverified"
                }
              }
            }
          },
          "flags": {
            "type": "array",
            "description": "machine facts only: security, unmaintained",
            "items": {
              "enum": [
                "security",
                "unmaintained",
                "contested",
                "hype-suspect",
                "astroturf-suspected",
                "stale-claim"
              ]
            }
          },
          "verdict": {
            "type": "string",
            "description": "human decision, preserved across recollects. 'contested' on a measured card fails abr check.",
            "enum": [
              "contested",
              "hype-suspect",
              "astroturf-suspected",
              "stale-claim",
              "clear"
            ]
          },
          "notes": {
            "type": "string",
            "description": "human note, preserved across recollects"
          }
        }
      }
    }
  }
}
